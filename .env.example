# Nova Voice Engine — Configuration
# Copy this file to .env and adjust as needed.

# Whisper model: tiny, base, small, medium, large-v3, etc.
WHISPER_MODEL=base

# Device: cpu or cuda
WHISPER_DEVICE=cpu

# Compute type: int8, int8_float16, float16, float32
# Use int8 for CPU, float16 for CUDA
WHISPER_COMPUTE_TYPE=int8

# Audio sample rate in Hz (Whisper expects 16000)
SAMPLE_RATE=16000

# Maximum recording duration in seconds (push-to-talk manual mode)
MAX_RECORDING_SECONDS=15

# Optional: force language (e.g., en, fr, de). Leave empty for auto-detect.
# WHISPER_LANGUAGE=en

# --- Text-to-Speech (Phase 2) ---
TTS_ENABLED=true
TTS_RATE=175
TTS_VOLUME=1.0
# Voice ID substring or exact ID. Empty = system default.
# Find voices: python -c "from app.tts.speaker import get_available_voices; [print(v.name, v.id) for v in get_available_voices()]"
TTS_VOICE=

# --- Wake Word (Phase 3) ---
WAKE_WORD_ENABLED=true
WAKE_WORD=hey nova
WAKE_WORD_THRESHOLD=0.5
COMMAND_TIMEOUT_SECONDS=8
WAKE_SOUND_ENABLED=true
WAKE_WORD_COOLDOWN_MS=500
