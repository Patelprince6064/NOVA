# Nova Voice Engine — Configuration
# Copy this file to .env and adjust as needed.

# Whisper model: tiny, base, small, medium, large-v3, etc.
WHISPER_MODEL=base

# Device: cpu or cuda
WHISPER_DEVICE=cpu

# Compute type: int8, int8_float16, float16, float32
# Use int8 for CPU, float16 for CUDA
WHISPER_COMPUTE_TYPE=int8

# Audio sample rate in Hz (Whisper expects 16000)
SAMPLE_RATE=16000

# Maximum recording duration in seconds (push-to-talk manual mode)
MAX_RECORDING_SECONDS=15

# Optional: force language (e.g., en, fr, de). Leave empty for auto-detect.
# WHISPER_LANGUAGE=en

# --- Text-to-Speech (Phase 2) ---
TTS_ENABLED=true
TTS_RATE=175
TTS_VOLUME=1.0
# Voice ID substring or exact ID. Empty = system default.
# Find voices: python -c "from app.tts.speaker import get_available_voices; [print(v.name, v.id) for v in get_available_voices()]"
TTS_VOICE=

# --- Wake Word (Phase 3) ---
WAKE_WORD_ENABLED=true
WAKE_WORD=hey nova
WAKE_WORD_THRESHOLD=0.5
COMMAND_TIMEOUT_SECONDS=8
WAKE_SOUND_ENABLED=true
WAKE_WORD_COOLDOWN_MS=500

# --- PC Control (Phase 4) ---
PC_CONTROL_ENABLED=true
DEFAULT_SCROLL_AMOUNT=5
ACTION_TIMEOUT_SECONDS=10
# Optional app paths (if not in PATH)
# BRAVE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# VSCODE_PATH=C:\Users\%USERNAME%\AppData\Local\Programs\Microsoft VS Code\Code.exe

# --- LLM Natural Language (Phase 5) ---
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=10

# --- Browser Control (Phase 6) ---
BROWSER_ENABLED=true
BROWSER_NAME=chromium
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=10000
